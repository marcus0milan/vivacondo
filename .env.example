# Referência para configurar as variáveis no terminal ou no provedor de deploy.
# ASP.NET Core não carrega este arquivo automaticamente.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=vivacondo;Username=postgres;Password=SUBSTITUA
JWT_SIGNING_KEY=
ASPNETCORE_URLS=http://localhost:5080

# O assistente é opcional; PDF do regimento pode ser enviado pelo síndico e fica no PostgreSQL.
# REGIMENTO_PATH é apenas uma alternativa para arquivo de texto legado.
OPENAI_API_KEY=
REGIMENTO_PATH=
